# ═══════════════════════════════════════════════════════════════════════════════
# RecoverAI — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control or share it.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Gemini ────────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>
DB_NAME=recovery_agent

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
# MINIMUM 32 characters — app WILL NOT START if this is shorter
SECRET_KEY=your-minimum-32-character-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Admin Access ──────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
# Example: ADMIN_EMAILS=admin@company.com,backup@company.com
ADMIN_EMAILS=your-admin-email@example.com

# ── WhatsApp / Messaging ──────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-token-here

# ── Webhook Security ──────────────────────────────────────────────────────────
# Optional: HMAC secret for verifying external webhook calls
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your-webhook-secret-here

# ── Application ───────────────────────────────────────────────────────────────
# IMPORTANT: Set DEBUG=false in production
# DEBUG=true enables /docs, /redoc, verbose errors (NEVER in production)
DEBUG=false

# CORS: comma-separated list of allowed frontend origins (NO wildcards)
# Add every domain that your frontend runs on
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-vercel-app.vercel.app

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Required for Google Sign-In
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
