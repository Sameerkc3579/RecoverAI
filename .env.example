# RecoverAI — environment template. Copy to .env and fill in; never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key                 # https://aistudio.google.com/app/apikey
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=recovery_agent
SECRET_KEY=change-me-to-64-random-hex-chars        # python -c "import secrets; print(secrets.token_hex(64))"

# ── App ───────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=you@example.com                       # comma-separated; unlocks the admin dashboard
ALLOWED_ORIGINS=http://localhost:8000
DEBUG=false                                        # true enables /docs and diagnostics
COOKIE_SECURE=false                                # true in production (HTTPS)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE_MB=10
TRUST_PROXY_HEADERS=false                          # automatic on Vercel

# ── Optional integrations ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                  # Google Sign-In
CRON_SECRET=                                       # protects /api/cron/drips (Vercel sends it automatically)
REDIS_URL=                                         # optional; MongoDB is used when unset

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=                           # Meta App Secret — inbound webhooks are rejected until set
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_AUTO_REPLY=false

# ── Email ingester worker (python -m app.workers.email_ingester) ──────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=invoices@example.com
IMAP_PASSWORD=your-app-password                    # Gmail App Password, not your account password
IMAP_MAILBOX=INBOX
IMAP_PROCESSED_FOLDER=Processed
MOVE_TO_FOLDER=false
REQUIRE_SENDER_AUTH=true                           # reject senders failing SPF/DKIM/DMARC
