# Environment Variables — RecoveryAgent Backend
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/recovery_agent?retryWrites=true&w=majority
DB_NAME=recovery_agent

# ── WhatsApp / Messaging ──────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-token-here

# ── Application ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DEBUG=true
